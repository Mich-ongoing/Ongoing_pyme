# Webminder Configuration Example
# Copy these values to your .env file and configure with real credentials

# Webminder Client Credentials (provided by the central panel)
WEBMINDER_CLIENT_ID=your_unique_client_id_here
WEBMINDER_CLIENT_SECRET=your_secret_key_here

# Branding (customize to your agency)
WEBMINDER_BRAND_NAME=Ongoing
WEBMINDER_BRAND_URL=https://ongoing.es
WEBMINDER_BRAND_COLOR=#4441FF
WEBMINDER_BRAND_COLOR_DARK=#3A37D9

# Optional: Customize timestamp tolerance (seconds) - default 900
# WEBMINDER_TIMESTAMP_TOLERANCE=900

# Optional: Customize database cleanup limit - default 500
# WEBMINDER_DB_CLEAN_MAX_POSTS=500

# Optional: SSO Configuration
# WEBMINDER_SSO_ENABLED=true
# WEBMINDER_SSO_TOKEN_LIFETIME=3600
